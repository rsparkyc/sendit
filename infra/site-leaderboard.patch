   HostedZoneId:
     Type: AWS::Route53::HostedZone::Id
     Description: Route 53 hosted zone that contains DomainName
+  # Leaderboard API (infra/leaderboard.yaml outputs). Empty: no /api/* routes (the site as before).
+  LeaderboardSubmitOrigin:
+    Type: String
+    Default: ''
+    Description: Leaderboard stack output SubmitOriginDomain (<id>.lambda-url.us-east-1.on.aws), or empty
+  LeaderboardReadOrigin:
+    Type: String
+    Default: ''
+    Description: Leaderboard stack output ReadOriginDomain, or empty
 
+Conditions:
+  HasLeaderboard: !And
+    - !Not [!Equals [!Ref LeaderboardSubmitOrigin, '']]
+    - !Not [!Equals [!Ref LeaderboardReadOrigin, '']]
+
 Rules:
   RequireUsEast1:
     Assertions:
@@ -107,6 +121,47 @@
           QueryStringsConfig:
             QueryStringBehavior: none
 
+  # Signs CloudFront's requests to the leaderboard function URLs (AuthType AWS_IAM).
+  LambdaOriginAccessControl:
+    Type: AWS::CloudFront::OriginAccessControl
+    Condition: HasLeaderboard
+    Properties:
+      OriginAccessControlConfig:
+        Name: !Sub '${AWS::StackName}-lambda-oac'
+        OriginAccessControlOriginType: lambda
+        SigningBehavior: always
+        SigningProtocol: sigv4
+
+  # /api/*: cache only what the function marks cacheable (boards: max-age=10), keyed on the query string.
+  ApiCachePolicy:
+    Type: AWS::CloudFront::CachePolicy
+    Condition: HasLeaderboard
+    Properties:
+      CachePolicyConfig:
+        Name: !Sub '${AWS::StackName}-api'
+        MinTTL: 0
+        DefaultTTL: 0
+        MaxTTL: 60
+        ParametersInCacheKeyAndForwardedToOrigin:
+          EnableAcceptEncodingGzip: true
+          EnableAcceptEncodingBrotli: true
+          CookiesConfig: { CookieBehavior: none }
+          HeadersConfig: { HeaderBehavior: none }
+          QueryStringsConfig: { QueryStringBehavior: all }
+
+  # Forward the viewer address (rate limiting). x-amz-content-sha256, which OAC needs to sign POSTs, is passed by CloudFront itself and is not allowed in a policy. No Host header (function URLs reject it).
+  ApiOriginRequestPolicy:
+    Type: AWS::CloudFront::OriginRequestPolicy
+    Condition: HasLeaderboard
+    Properties:
+      OriginRequestPolicyConfig:
+        Name: !Sub '${AWS::StackName}-api'
+        CookiesConfig: { CookieBehavior: none }
+        HeadersConfig:
+          HeaderBehavior: whitelist
+          Headers: [CloudFront-Viewer-Address, content-type]
+        QueryStringsConfig: { QueryStringBehavior: all }
+
   Distribution:
     Type: AWS::CloudFront::Distribution
     Properties:
