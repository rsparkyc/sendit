{
  "name": "sendit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:slow": "SLOW=1 vitest run test/nbody-moons.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "build:leaderboard": "vite build --config server/leaderboard/vite.config.ts",
    "bench:leaderboard": "pnpm build:leaderboard && for s in chunk lunar longest-escape; do node dist-server/leaderboard/bench.mjs $s; done",
    "gen:checkpoints": "node scripts/gen-checkpoints.mjs",
    "gen:campaign-sites": "python3 scripts/gen-campaign-sites.py",
    "gen:dop853":"python3 scripts/gen-dop853.py > src/physics/dop853-coefficients.ts",
    "test:browsers": "playwright test --config e2e/playwright.config.ts",
    "bench:ephemeris": "BENCH=1 vitest run test/ephemeris-bench.test.ts --silent=false"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
